{
  "compilerOptions": {
    "target": "es5",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react",
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "webpack-env",
      "react",
      "react-dom"
    ],
    "lib": [
      "es5",
      "dom",
      "es2015",
      "es2016",
      "es2017",
      "es2015.collection",
      "es2015.promise"
    ]
  },
  "include": [
    "src/formEngine/core/types.ts",
    "src/webparts/sharePointDynamicForm/SharePointDynamicFormWebPart.ts",
    "src/webparts/sharePointDynamicForm/components/SharePointDynamicForm.tsx",
    "src/webparts/sharePointDynamicForm/loc/mystrings.d.ts",
    "src/webparts/sharePointDynamicForm/loc/en-us.js"
  ],
  "exclude": [
    "config",
    "dist",
    "lib",
    "node_modules",
    "release",
    "scripts",
    "temp",
    "src/designer/**",
    "src/formEngine/components/**",
    "src/formEngine/fields/**",
    "src/formEngine/hooks/**",
    "src/formEngine/data/**",
    "src/formEngine/utils/**",
    "src/formEngine/core/FormStateManager.ts",
    "src/formEngine/core/ValidationEngine.ts",
    "src/webparts/sharePointDynamicForm/propertyPane/**"
  ]
}